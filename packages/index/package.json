{
  "name": "vitepress-theme-index",
  "version": "0.0.1",
  "author": "soppylzz",
  "packageManager": "pnpm@10.12.4",
  "license": "MIT",
  "keywords": [
    "vitepress",
    "vitepress-theme"
  ],
  "type": "module",
  "main": "./dist/node/index.mjs",
  "module": "./dist/node/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/node/index.mjs",
      "require": "./dist/node/index.cjs"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.mjs",
      "require": "./dist/node/index.cjs"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.mjs"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.mjs",
      "require": "./dist/shared/index.cjs"
    },
    "./theme/*": "./dist/theme/*"
  },
  "bin": {
    "vti": "dist/cli/cli.mjs"
  },
  "peerDependencies": {
    "vitepress": "^1.6.0",
    "vite": "^5.4.21",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "p-limit": "^7.3.0",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.4",
    "gray-matter": "^4.0.3",
    "simple-git": "^3.33.0",
    "qrcode": "^1.5.4",
    "gsap": "^3.14.2",
    "chalk": "^5.6.2",
    "consola": "^3.4.2",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.22",
    "lodash-unified": "^1.0.3",
    "@types/qrcode": "^1.5.6",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.23",
    "@types/lodash-es": "^4.17.12",
    "@types/cross-spawn": "^6.0.6",
    "@types/ejs": "^3.1.5",
    "vue-i18n": "^11.2.8",
    "cross-spawn": "^7.0.6",
    "ejs": "^5.0.2",
    "mri": "^1.2.0",
    "@giscus/vue": "^3.1.1",
    "@clack/prompts": "^1.2.0"
  }
}
