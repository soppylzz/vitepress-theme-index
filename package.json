{
  "name": "@vitepress-theme-index/monorepo",
  "private": "true",
  "author": "soppylzz",
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "lint": "eslint . --ext .vue,.js,.ts,.cjs,.mjs,.cts,.mts,.jsx,.tsx",
    "lint:fix": "pnpm run lint --fix",
    "format": "prettier --write --experimental-cli .",
    "play:dev": "pnpm run build && pnpm run -C packages/play docs:dev",
    "play:build": "pnpm run build && pnpm run -C packages/play docs:build",
    "play:preview": "pnpm run -C packages/play docs:preview",
    "build": "pnpm run -C scripts/build build:pipe",
    "build:types": "vue-tsc -p ./tsconfig.lib.json",
    "clean:dist": "rimraf dist && rimraf packages/index/dist",
    "prepare": "husky"
  },
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "@types/lodash": "^4.17.23",
    "@types/lodash-es": "^4.17.12",
    "@types/qrcode": "^1.5.6",
    "@vercel/detect-agent": "^1.2.2",
    "@vitepress-theme-index/client": "workspace:*",
    "@vitepress-theme-index/node": "workspace:*",
    "@vitepress-theme-index/shared": "workspace:*",
    "@vitepress-theme-index/theme": "workspace:*",
    "chalk": "^5.6.2",
    "consola": "^3.4.2",
    "cross-spawn": "^7.0.6",
    "ejs": "^5.0.2",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.4",
    "gray-matter": "^4.0.3",
    "gsap": "^3.14.2",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.22",
    "lodash-unified": "^1.0.3",
    "mri": "^1.2.0",
    "p-limit": "^7.3.0",
    "qrcode": "^1.5.4",
    "simple-git": "^3.33.0",
    "vue-i18n": "^11.2.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.0.3",
    "@vitepress-theme-index/eslint": "workspace:*",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "lightningcss": "1.21.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "sass": "^1.97.1",
    "typescript": "5.8.2",
    "vitepress": "^1.6.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.1.0"
  },
  "lint-staged": {
    "*.{vue,js,ts,cjs,mjs,cts,mts,jsx,tsx}": [
      "eslint --fix --concurrency=auto",
      "prettier --write --experimental-cli"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
