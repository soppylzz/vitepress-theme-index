{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "jsx": "preserve",
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true
  },
  "include": ["packages"],
  "exclude": ["node_modules", "dist", "packages/play"]
}
